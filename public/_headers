# Cabeceras de seguridad — Netlify y Cloudflare Pages las leen de este archivo.
# Para Vercel, lo mismo está en vercel.json.
#
# La política de contenido es la barrera contra XSS: aunque se colara un script
# en algún texto, el navegador no lo ejecutaría porque no viene de este origen.

/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://tile.openstreetmap.org https://*.tile.openstreetmap.org; font-src 'self' data:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://tile.openstreetmap.org https://*.tile.openstreetmap.org; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Los archivos con hash en el nombre no cambian nunca: se cachean para siempre.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
